fn greet(name) {
    let message = `Hello, ${name}! Welcome to VerbLang.`;
    return message;
}

// Top level execution
let target = "World";
let welcome = greet(target);
print(welcome);

let author = "Verbund Labs";
print(`VerbLang native runtime initialized by ${author}.`);
